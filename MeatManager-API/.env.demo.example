# ─── MeatManager API - Demo / Dev contra BD clonada ─────────────────────────
# Copiar este archivo como .env.demo y completar los valores reales.

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=
DB_PROVISION_USER=root
DB_PROVISION_PASS=

MEATMANAGER_DB_NAME=meatmanager
OPERATIONAL_DB_NAME=meatmanager
DEFAULT_OPERATIONAL_TENANT_ID=1

CLIENTS_DB_NAME=GestionClientes
CLIENTS_DB_HOST=127.0.0.1
CLIENTS_DB_PORT=3307
CLIENTS_DB_USER=root
CLIENTS_DB_PASS=

CLIENTS_TABLE=clients
CLIENT_BRANCHES_TABLE=branches
CLIENT_USERS_TABLE=client_users
CLIENT_LICENSES_TABLE=client_licenses
CLIENT_USER_PERMISSIONS_TABLE=client_user_permissions
LICENSES_TABLE=licenses

FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
ALLOW_LOCAL_UNVERIFIED_AUTH=true

PORT=3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Opcional en demo local
REDIS_HOST=
REDIS_PORT=6379
SMTP_HOST=
SMTP_PORT=
